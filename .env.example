# Where Framelane keeps its SQLite database, uploads and secret key. Defaults to ./data.
FRAMELANE_DATA_DIR=./data

# Encrypts stored App Store Connect keys. Optional: without it Framelane creates
# <data dir>/secret.key on first use. Back that file up together with the database.
# FRAMELANE_SECRET=

# Only for development and tests: point the App Store Connect client at another server.
# FRAMELANE_ASC_URL=http://127.0.0.1:3199

# Require a password for the whole app (HTTP Basic auth). Recommended before exposing Framelane
# beyond your own machine. The username defaults to "admin".
# FRAMELANE_PASSWORD=
# FRAMELANE_USERNAME=admin
